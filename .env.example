NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Strava OAuth. Son privadas: nunca uses el prefijo NEXT_PUBLIC_ ni las expongas al navegador.
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
# Genera una clave estable con: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# Bolt AI. Todas son privadas y solo se leen en el servidor.
# El módulo permanece oculto mientras AI_ENABLED no sea true o falte la API key.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_PLAN_MODEL=gemini-3.1-flash-lite
GEMINI_PLAN_FALLBACK_MODEL=gemini-3.5-flash-lite
# Se usa únicamente si el modelo principal responde con un error temporal.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Límites por usuario: chat/análisis por hora y planes completos por 24 horas.
AI_MAX_CHAT_REQUESTS=30
AI_MAX_PLAN_GENERATIONS=4

# Solo para ejecutar los seeds locales. No las agregues a Vercel.
SEED_EMAIL=hugo@example.com
SEED_PASSWORD=replace-with-your-password
# Opcional: el script verifica que coincida con la sesión autenticada.
SEED_USER_ID=
