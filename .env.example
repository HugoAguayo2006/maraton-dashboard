NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Strava OAuth. Son privadas: nunca uses el prefijo NEXT_PUBLIC_ ni las expongas al navegador.
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
# Genera una clave estable con: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# Solo para ejecutar los seeds locales. No las agregues a Vercel.
SEED_EMAIL=hugo@example.com
SEED_PASSWORD=replace-with-your-password
# Opcional: el script verifica que coincida con la sesión autenticada.
SEED_USER_ID=
