NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL canonica de produccion. En Preview, Vercel aporta VERCEL_URL automaticamente.
NEXT_PUBLIC_SITE_URL=

# Strava OAuth. Son privadas: nunca uses el prefijo NEXT_PUBLIC_ ni las expongas al navegador.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
# Genera una clave estable con: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Bolt AI. Todas son privadas y solo se leen en el servidor.
# El módulo permanece oculto mientras AI_ENABLED no sea true o falte la API key.
AI_ENABLED=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_PLAN_MODEL=
GEMINI_PLAN_FALLBACK_MODEL=
# Se usa si el modelo principal no existe o responde con un error temporal.
GEMINI_FALLBACK_MODEL=
# Límites por usuario: chat/análisis por hora y planes completos por 24 horas.
AI_MAX_CHAT_REQUESTS=
AI_MAX_PLAN_GENERATIONS=

# Solo para ejecutar los seeds locales. No las agregues a Vercel.
SEED_EMAIL=
SEED_PASSWORD=
# Opcional: el script verifica que coincida con la sesión autenticada.
SEED_USER_ID=
